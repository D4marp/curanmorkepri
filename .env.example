# =============================================================================
# CURANMOR AI — konfigurasi environment
# Salin file ini menjadi ".env" lalu isi nilai di bawah SEBELUM menjalankan
# `docker compose up -d`. JANGAN commit file ".env" ke git — sudah termasuk
# dalam .gitignore.
# =============================================================================

# ---------- Database ----------
# Isi field TERPISAH ini dengan nilai persis dari panel provisioning
# database kamu (biasanya ditampilkan sebagai kartu "Host / Port / Username /
# Password / Database Name") — cocok untuk docker-compose lokal MAUPUN
# deploy ke PaaS (Coolify/Railway/DO App Platform, dll). Aplikasi merakit
# connection string Postgres dari 5 nilai ini secara otomatis & aman
# (termasuk kalau password mengandung karakter spesial seperti @ : /).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=curanmor_ai
# "require" cocok untuk kebanyakan database terkelola (managed). Untuk
# docker-compose lokal (container Postgres sendiri, tanpa TLS) pakai "disable".
DB_SSLMODE=require

# Alternatif: kalau provider kamu justru kasih SATU connection string
# (bukan field terpisah), isi DATABASE_URL saja dan kosongkan 6 baris
# DB_* di atas — DATABASE_URL selalu diutamakan kalau diisi.
# DATABASE_URL=postgres://user:password@host:5432/curanmor_ai?sslmode=require

# ---------- Keamanan aplikasi ----------
# WAJIB string acak minimal 32 karakter, BEDA dari lingkungan dev/lokal.
# Cara generate: openssl rand -hex 32
JWT_SECRET=
APP_ENCRYPTION_KEY=
JWT_ISSUER=curanmor-ai.polda-kepri.go.id
ACCESS_TOKEN_TTL_MINUTES=60

# ---------- Akun Super Admin awal ----------
# Diterapkan HANYA sekali saat database masih kosong (proses seeding
# pertama kali). Kosongkan berdua untuk pakai default bawaan skrip seed
# (NRP 00000000 / password ChangeMe!12345 — WAJIB diganti manual setelah
# login pertama bila memilih opsi ini). Untuk deployment produksi,
# SANGAT DISARANKAN isi kedua nilai ini dengan kredensial Anda sendiri,
# supaya tidak ada instalasi yang berbagi password default yang sama.
SEED_ADMIN_NRP=000000000
SEED_ADMIN_PASSWORD=curanmor123

# ---------- Upload berkas ----------
MAX_UPLOAD_SIZE_MB=10
HTTP_PUBLISH_PORT=8080
CORS_ALLOWED_ORIGINS=*
COOKIE_DOMAIN=
APP_ENV=production
