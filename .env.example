# =============================================================================
# CURANMOR AI — konfigurasi environment
# Salin file ini menjadi ".env" lalu isi nilai di bawah SEBELUM menjalankan
# `docker compose up -d`. JANGAN commit file ".env" ke git — sudah termasuk
# dalam .gitignore.
# =============================================================================

# ---------- Database (docker-compose lokal) ----------
# Dipakai HANYA saat menjalankan lewat docker-compose (docker-compose.yml
# meng-construct DATABASE_URL dari 3 nilai ini). Abaikan kalau deploy ke PaaS.
POSTGRES_DB=curanmor_ai
POSTGRES_USER=curanmor
POSTGRES_PASSWORD=

# ---------- Database eksternal (PaaS: Coolify/Railway/DO App Platform, dll) ----------
# Set LANGSUNG di dashboard env vars platform kamu, bukan lewat file ini.
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgres://postgres:GANTI_PASSWORD@host-database-anda:5432/curanmor_ai?sslmode=require

JWT_SECRET=
APP_ENCRYPTION_KEY=
JWT_ISSUER=curanmor-ai.polda-kepri.go.id
ACCESS_TOKEN_TTL_MINUTES=60

# ---------- Akun Super Admin awal ----------
# Diterapkan HANYA sekali saat database masih kosong (proses seeding
# pertama kali). Kosongkan berdua untuk pakai default bawaan skrip seed
# (NRP 00000000 / password ChangeMe!12345 — WAJIB diganti manual setelah
# login pertama bila memilih opsi ini). Untuk deployment produksi,
# SANGAT DISARANKAN isi kedua nilai ini dengan kredensial Anda sendiri,
# supaya tidak ada instalasi yang berbagi password default yang sama.
SEED_ADMIN_NRP=000000000
SEED_ADMIN_PASSWORD=curanmor123

# ---------- Upload berkas ----------
MAX_UPLOAD_SIZE_MB=10
HTTP_PUBLISH_PORT=8080
CORS_ALLOWED_ORIGINS=*
COOKIE_DOMAIN=
APP_ENV=production
